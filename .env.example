# Agent seeds: use your OWN long random phrases. Same seed = same address.
AGENT_SEED=change-me-to-a-long-random-phrase
PRICE_AGENT_SEED=change-me-to-a-different-long-random-phrase
PARSER_AGENT_SEED=change-me-to-another-long-random-phrase
POLICY_AGENT_SEED=change-me-to-one-more-long-random-phrase
CLAIM_AGENT_SEED=change-me-to-a-claim-agent-phrase

# Address printed by `uv run price_agent.py` (agent1q...)
PRICE_AGENT_ADDRESS=
# Address printed by `uv run parser_agent.py` (Phase 2)
PARSER_AGENT_ADDRESS=
# Address printed by `uv run policy_agent.py` (Phase 3; no keys needed)
POLICY_AGENT_ADDRESS=
# Address printed by `uv run claim_agent.py` (Phase 3, refund request drafts)
CLAIM_AGENT_ADDRESS=

# Price watch: the coordinator re-checks items older than this many hours and messages users
# about new drops (1 Bright Data credit per check). 0 turns it off.
PRICE_WATCH_HOURS=6

# Bright Data API key: one key for the Scraper API and the MCP (price agent)
BRIGHTDATA_API_TOKEN=

# ASI:One API key from asi1.ai. The parser agent uses it to read receipt photos
# and email text (asi1 reads images itself, no other key needed); the claim agent
# uses it to draft refund requests.
ASI_ONE_API_KEY=

# Email receipts (Phase 2): see "Email receipts" in AGENTS.md
# server.py's own identity; its address (shown at /health) goes in SERVER_ADDRESS
SERVER_SEED=change-me-to-yet-another-long-random-phrase
SERVER_ADDRESS=
# Coordinator address (printed by `uv run agent.py`), where server.py sends emails
COORDINATOR_ADDRESS=
# Optional, only for Pipedream forwarding (not used): leave empty and /email refuses everything
# Shared secret Pipedream sends in the X-Webhook-Secret header
WEBHOOK_SECRET=
# Pipedream email trigger address users forward order emails to
RECEIPT_INBOX=

# Gmail connect (OAuth): see "Gmail connect" in AGENTS.md
# Server's base URL (Vercel, or http://localhost:8000 for testing). Coordinator and server both need it.
PUBLIC_URL=
# Random hex, the SAME value for the coordinator and the server (signs the Connect Gmail link)
OAUTH_STATE_SECRET=
# From Google Cloud Console > Google Auth Platform > Clients (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

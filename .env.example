# Agent seeds: use your OWN long random phrases. Same seed = same address.
AGENT_SEED=change-me-to-a-long-random-phrase
PRICE_AGENT_SEED=change-me-to-a-different-long-random-phrase
PARSER_AGENT_SEED=change-me-to-another-long-random-phrase

# Address printed by `uv run price_agent.py` (agent1q...)
PRICE_AGENT_ADDRESS=

# Bright Data MCP token (price agent)
BRIGHTDATA_API_TOKEN=

# ASI:One LLM key from asi1.ai (not needed for Phase 1)
ASI_ONE_API_KEY=

# Shared secret for the Pipedream -> FastAPI webhook (Phase 2)
WEBHOOK_SECRET=
